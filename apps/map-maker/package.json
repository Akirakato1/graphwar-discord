  "dependencies": {
    "@graphwar/shared": "file:../../packages/shared",
    "electron": "^31.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0"
  }
}
